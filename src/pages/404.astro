---
import AstroPaperLayout from "@/layouts/AstroPaperLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const links = [
  { href: "/", label: "返回首页" },
  { href: "/archives", label: "浏览归档" },
  { href: "/tags", label: "查看标签" },
];
---

<AstroPaperLayout
  title={`404 | ${config.site.title}`}
  description="页面不存在"
>
  <Header />

  <div class="page-shell pt-4 pb-16 grow">
    <div
      class="fuwari-card p-8 sm:p-14 border border-border/80 text-center flex flex-col items-center justify-center min-h-[52vh]"
    >
      <div
        class="text-6xl sm:text-8xl font-black tracking-tight text-accent/80 font-mono select-none"
      >
        404
      </div>

      <h1 class="mt-4 text-xl sm:text-2xl font-bold text-foreground">
        页面走丢了
      </h1>

      <p class="mt-2 text-sm text-muted-foreground max-w-md leading-relaxed">
        你访问的页面不存在、已经被移动，或者对应的 GitHub Issue 还没有发布。
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {
          links.map(({ href, label }, index) => (
            <a
              href={href}
              class:list={[
                "inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold transition-all duration-200",
                index === 0
                  ? "bg-accent text-accent-foreground shadow-sm hover:opacity-90"
                  : "bg-muted/60 text-foreground/80 border border-border/60 hover:bg-accent hover:text-white hover:border-accent/80",
              ]}
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <Footer />
</AstroPaperLayout>
