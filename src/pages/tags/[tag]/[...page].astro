---
import type { GetStaticPathsOptions } from "astro";
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import FuwariBentoCard from "@/components/fuwari/FuwariBentoCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getPosts } from "@/lib/posts";
import { getTagSlug } from "@/utils/tagUrl";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPosts();

  // 聚合所有去重后的 tag 映射: slug -> 原始 tag 名称
  const tagMap = new Map<string, string>();
  posts.forEach(post => {
    post.data.tags.forEach(tag => {
      const slug = getTagSlug(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, tag);
      }
    });
  });

  return Array.from(tagMap.entries()).flatMap(([slug, tagName]) => {
    const tagPosts = posts.filter(post =>
      post.data.tags.some(t => getTagSlug(t) === slug)
    );

    return paginate(tagPosts, {
      params: { tag: slug },
      props: { tagName, slug },
      pageSize: 10,
    });
  });
}

const { page, tagName } = Astro.props;
const allPosts = await getPosts();

// 提取全站标签统计
const tagCounts = new Map<string, number>();
const yearsMap = new Map<string, number>();

allPosts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });

  const year = post.data.pubDate.getFullYear().toString();
  yearsMap.set(year, (yearsMap.get(year) ?? 0) + 1);
});

const tagsWithCount = Array.from(tagCounts, ([tag, count]) => ({
  tag,
  count,
})).sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, "zh-CN"));

const yearsList = Array.from(yearsMap, ([year, count]) => ({
  year,
  count,
})).sort((a, b) => Number(b.year) - Number(a.year));
---

<FuwariBlogLayout
  title={`标签: ${tagName} | ${config.site.title}`}
  postsCount={allPosts.length}
  years={yearsList}
  tags={tagsWithCount}
>
  <!-- 顶部标签标题小卡片 -->
  <div class="fuwari-card p-4 mb-4 flex items-center justify-between border border-border/70">
    <div class="flex items-center gap-2 font-bold text-sm sm:text-base text-foreground">
      <span class="w-1.5 h-4 rounded-full bg-accent"></span>
      <span>标签筛选：</span>
      <span class="px-2.5 py-0.5 rounded-lg bg-accent/15 text-accent font-mono text-xs">
        #{tagName}
      </span>
    </div>
    <div class="text-xs text-muted-foreground font-mono">
      共 {page.total} 篇文章
    </div>
  </div>

  <!-- 文章 Bento 卡片列表 -->
  <div class="space-y-4">
    {page.data.map(post => (
      <FuwariBentoCard post={post} />
    ))}
  </div>

  <!-- 分页控件 -->
  {page.lastPage > 1 && (
    <div class="mt-6 flex justify-center">
      <Pagination {page} />
    </div>
  )}
</FuwariBlogLayout>
