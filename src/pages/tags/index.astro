---
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import { getPosts, getSidebarStats } from "@/lib/posts";
import { getTagUrl } from "@/utils/tagUrl";
import config from "@/config";

const posts = await getPosts();
const { years: yearsList, categories, tags: tagsWithCount } = getSidebarStats(posts);
---

<FuwariBlogLayout
  title={`标签云 | ${config.site.title}`}
  postsCount={posts.length}
  years={yearsList}
  categories={categories}
  tags={tagsWithCount}
>
  <!-- 标签聚合 Bento 卡片 -->
  <div class="fuwari-card p-5 sm:p-8 border border-border/80">
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-border/60">
      <div class="flex items-center gap-2 font-bold text-base sm:text-lg text-foreground">
        <span class="w-1.5 h-4 rounded-full bg-accent"></span>
        <span>标签云</span>
      </div>
      <span class="text-xs text-muted-foreground font-mono">
        收录 {tagsWithCount.length} 个标签
      </span>
    </div>

    <!-- 标签胶囊阵列 -->
    <div class="flex flex-wrap gap-2.5 sm:gap-3">
      {tagsWithCount.map(({ tag, count }) => (
        <a
          href={getTagUrl(tag)}
          class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-muted/60 hover:bg-accent hover:text-white border border-border/50 hover:border-accent/80 transition-all duration-200 transform hover:-translate-y-0.5"
        >
          <span class="text-xs sm:text-sm font-medium text-foreground/80 group-hover:text-white transition-colors">
            #{tag}
          </span>
          <span class="px-1.5 py-0.5 rounded-md bg-background/80 group-hover:bg-white/20 text-[10px] font-mono text-muted-foreground group-hover:text-white font-bold transition-colors">
            {count}
          </span>
        </a>
      ))}

      {tagsWithCount.length === 0 && (
        <span class="text-sm text-muted-foreground">暂无标签</span>
      )}
    </div>
  </div>
</FuwariBlogLayout>
