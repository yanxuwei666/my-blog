---
import type { GetStaticPathsOptions } from "astro";
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import FuwariBentoCard from "@/components/fuwari/FuwariBentoCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getPosts, getSidebarStats } from "@/lib/posts";
import { getCategorySlug } from "@/utils/categoryUrl";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPosts();
  const categoryMap = new Map<string, string>();

  posts.forEach(post => {
    const category = post.data.category || "未分类";
    categoryMap.set(getCategorySlug(category), category);
  });

  return Array.from(categoryMap.entries()).flatMap(([slug, categoryName]) => {
    const categoryPosts = posts.filter(
      post => (post.data.category || "未分类") === categoryName
    );

    return paginate(categoryPosts, {
      params: { category: slug },
      props: { categoryName },
      pageSize: 10,
    });
  });
}

const { page, categoryName } = Astro.props;
const allPosts = await getPosts();
const { years, categories, tags } = getSidebarStats(allPosts);
---

<FuwariBlogLayout
  title={`分类: ${categoryName} | ${config.site.title}`}
  description={`查看分类“${categoryName}”下的全部文章`}
  postsCount={allPosts.length}
  years={years}
  categories={categories}
  tags={tags}
>
  <div class="fuwari-card p-4 mb-4 flex items-center justify-between border border-border/70">
    <div class="flex items-center gap-2 font-bold text-sm sm:text-base text-foreground">
      <span class="w-1.5 h-4 rounded-full bg-accent"></span>
      <span>分类筛选：</span>
      <span class="px-2.5 py-0.5 rounded-lg bg-accent/15 text-accent text-xs">
        {categoryName}
      </span>
    </div>
    <div class="text-xs text-muted-foreground font-mono">
      共 {page.total} 篇文章
    </div>
  </div>

  <div class="space-y-4">
    {page.data.map(post => (
      <FuwariBentoCard post={post} />
    ))}
  </div>

  {page.lastPage > 1 && (
    <div class="mt-6 flex justify-center">
      <Pagination {page} />
    </div>
  )}
</FuwariBlogLayout>
