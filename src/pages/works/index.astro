---
import FuwariBlogLayout from "@/layouts/FuwariBlogLayout.astro";
import { getPosts, getSidebarStats } from "@/lib/posts";
import config from "@/config";

const posts = await getPosts();
const { years, categories, tags } = getSidebarStats(posts);
---

<FuwariBlogLayout
  title={`作品 | ${config.site.title}`}
  description="作品集"
  postsCount={posts.length}
  years={years}
  categories={categories}
  tags={tags}
>
  <div
    class="fuwari-card flex min-h-[24rem] flex-col items-center justify-center bg-accent/[0.035] p-8 text-center sm:p-14"
  >
    <h1 class="text-xl sm:text-2xl font-bold text-foreground">作品</h1>

    <p class="mt-2 text-sm text-muted-foreground max-w-md leading-relaxed">
      这个入口先保留，后续会补充项目和实践成果。当前可以先从博客和分类开始浏览。
    </p>
    <a href="/" class="mt-5 text-sm font-semibold text-accent transition-colors hover:text-foreground">
      返回文章列表 →
    </a>
  </div>
</FuwariBlogLayout>
