---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

type AdjacentPost = {
  id: string;
  title: string;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;

const getUrl = (id: string) => `/blog/${id.replace(/\.(md|mdx)$/i, "")}/`;
---

{(prevPost || nextPost) && (
  <nav
    data-pagefind-ignore
    aria-label="文章导航"
    class="my-6 flex flex-col gap-2 border-t border-border/60 pt-6 sm:flex-row sm:items-start sm:justify-between"
  >
    {
      prevPost && (
        <a
          href={getUrl(prevPost.id)}
          class="group flex min-w-0 items-start gap-2.5 rounded-xl p-3 hover:bg-accent/10 transition-colors"
        >
          <IconArrowLeft class="mt-0.5 size-4 flex-none text-muted-foreground group-hover:text-accent transition-colors rtl:rotate-180" />
          <div class="min-w-0">
            <span class="block text-xs text-muted-foreground">上一篇</span>
            <div class="truncate text-xs font-semibold text-foreground transition-colors group-hover:text-accent sm:text-sm">{prevPost.title}</div>
          </div>
        </a>
      )
    }
    {
      nextPost && (
        <a
          href={getUrl(nextPost.id)}
          class="group flex min-w-0 items-start justify-end gap-2.5 rounded-xl p-3 text-end hover:bg-accent/10 transition-colors sm:ms-auto"
        >
          <div class="min-w-0">
            <span class="block text-xs text-muted-foreground">下一篇</span>
            <div class="truncate text-xs font-semibold text-foreground transition-colors group-hover:text-accent sm:text-sm">{nextPost.title}</div>
          </div>
          <IconArrowRight class="mt-0.5 size-4 flex-none text-muted-foreground group-hover:text-accent transition-colors rtl:rotate-180" />
        </a>
      )
    }
  </nav>
)}
