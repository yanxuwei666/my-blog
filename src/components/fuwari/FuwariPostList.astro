---
import FuwariBentoCard from "@/components/fuwari/FuwariBentoCard.astro";
import Pagination from "@/components/Pagination.astro";
import type { PostPager } from "@/lib/posts";

interface Props {
  page: PostPager;
  withYearAnchors?: boolean;
}

const { page, withYearAnchors = false } = Astro.props;
const isLastPage = !page.url.next;
---

<div id="post-list" class="space-y-4">
  {page.data.map((post, index) => {
    const year = post.data.pubDate.getFullYear().toString();
    const previousYear = index > 0
      ? page.data[index - 1].data.pubDate.getFullYear().toString()
      : undefined;
    const isYearStart = withYearAnchors && year !== previousYear;

    return isYearStart ? (
      <div id={`year-${year}`} class="scroll-mt-24">
        <FuwariBentoCard post={post} />
      </div>
    ) : (
      <FuwariBentoCard post={post} />
    );
  })}
</div>

<!--
  触底自动加载下一页；禁用 JS 时这里就是一套普通的上一页/下一页链接。
  data-* 供脚本判断还剩几页，翻页后整块替换成下一页的 markup。
-->
<div
  id="post-more"
  data-current={page.currentPage}
  data-last={page.lastPage}
  data-total={page.total}
  data-next={page.url.next ?? ""}
>
  <Pagination page={page} />
</div>

{
  isLastPage && (
    <p class="py-4 text-center text-xs text-muted-foreground font-mono">
      已经到底了 · 共 {page.total} 篇文章
    </p>
  )
}

<script is:inline data-astro-rerun>
  function initPostListAutoLoad() {
    const wrap = document.getElementById("post-more");
    const list = document.getElementById("post-list");
    if (!wrap || !list || !wrap.dataset.next) return;

    let next = wrap.dataset.next;
    let current = Number(wrap.dataset.current ?? 1);
    const last = Number(wrap.dataset.last ?? 1);
    const total = Number(wrap.dataset.total ?? 0);
    let loading = false;

    const tip = document.createElement("p");
    tip.className =
      "py-4 text-center text-xs text-muted-foreground font-mono";
    tip.setAttribute("aria-live", "polite");
    wrap.before(tip);

    async function loadNext() {
      loading = true;
      tip.textContent = `正在加载第 ${current + 1} / ${last} 页…`;

      try {
        const res = await fetch(next, { credentials: "same-origin" });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const doc = new DOMParser().parseFromString(
          await res.text(),
          "text/html"
        );
        doc
          .querySelectorAll("#post-list > *")
          .forEach(node => list.appendChild(node));

        current += 1;

        const source = doc.getElementById("post-more");
        next = source?.dataset.next ?? "";
        if (source) wrap.innerHTML = source.innerHTML;

        if (next) {
          tip.textContent = `已加载 ${current} / ${last} 页，继续下拉`;
        } else {
          observer.disconnect();
          wrap.remove();
          tip.textContent = `已经到底了 · 共 ${total} 篇文章`;
        }
      } catch (error) {
        observer.disconnect();
        tip.textContent = "自动加载失败，可以用下面的分页按钮继续";
      }

      loading = false;

      // 屏幕很高时一次加载完还够不到触底点，主动再判断一次
      if (next && wrap.getBoundingClientRect().top < window.innerHeight + 400) {
        loadNext();
      }
    }

    const observer = new IntersectionObserver(
      entries => {
        if (!loading && entries.some(entry => entry.isIntersecting)) loadNext();
      },
      { rootMargin: "400px 0px" }
    );
    observer.observe(wrap);
  }
  initPostListAutoLoad();
</script>
