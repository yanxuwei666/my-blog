---
import type { MarkdownHeading } from "astro";

interface Props {
  headings?: MarkdownHeading[];
}

const { headings = [] } = Astro.props;

// 智能识别顶层深度（例如有的文章以 h1 为主要章节，有的以 h2 为主要章节）
const minDepth = headings.length > 0 ? Math.min(...headings.map(h => h.depth)) : 2;
const primaryDepth = Math.max(minDepth, 1);
const secondaryDepth = primaryDepth + 1;

const filteredHeadings = headings.filter(h => h.depth >= primaryDepth && h.depth <= secondaryDepth);

// 计算编号辅助
let primaryIndex = 0;
---

{filteredHeadings.length > 0 && (
  <div class="fuwari-card p-4 border border-border/70 max-h-[calc(100vh-2rem)] overflow-y-auto">
    <div class="flex items-center gap-2 mb-3 pb-2 border-b border-border/50 text-xs font-bold text-foreground">
        <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span>目录</span>
      </div>

      <nav class="space-y-1 text-xs">
        {filteredHeadings.map(heading => {
          let badgeText = "";
          if (heading.depth === primaryDepth) {
            primaryIndex += 1;
            badgeText = String(primaryIndex);
          }

          return (
            <a
              href={`#${heading.slug}`}
              class:list={[
                "flex items-center gap-2 py-1.5 px-2 rounded-lg text-muted-foreground hover:bg-accent/10 hover:text-accent transition-colors truncate leading-relaxed font-semibold",
                heading.depth === secondaryDepth ? "pl-5 text-[11px] opacity-85" : ""
              ]}
              title={heading.text}
            >
              {heading.depth === primaryDepth ? (
                <span class="w-4 h-4 shrink-0 rounded bg-accent/15 text-accent text-[10px] font-bold flex items-center justify-center">
                  {badgeText}
                </span>
              ) : (
                <span class="w-1.5 h-1.5 shrink-0 rounded-full bg-border group-hover:bg-accent ml-1 mr-1"></span>
              )}
              <span class="truncate">{heading.text}</span>
            </a>
          );
        })}
      </nav>
    </div>
)}
