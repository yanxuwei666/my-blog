---
import config from "@/config";
import IconRss from "@/assets/icons/IconRss.svg";

interface Props {
  postsCount?: number;
  yearsCount?: number;
  tagsCount?: number;
}

const {
  postsCount = 0,
  yearsCount = 0,
  tagsCount = 0,
} = Astro.props;

const { site, socials } = config;
const authorName = site.author || "Blogger";
const authorBio = site.authorBio || site.description || "记录代码实践，分享成长路上的每一步";

// 动态解析头像：优先使用 authorAvatar，其次从 GitHub profile 解析，最后回退到 favicon.svg
const githubSocial = socials.find(s => s.name.toLowerCase() === "github");
const githubUrl = site.profile || githubSocial?.url || "https://github.com";

let resolvedAvatar = site.authorAvatar;
if (!resolvedAvatar && githubUrl.includes("github.com/")) {
  const match = githubUrl.match(/github\.com\/([^/?#]+)/);
  if (match && match[1]) {
    resolvedAvatar = `https://github.com/${match[1]}.png`;
  }
}
if (!resolvedAvatar) {
  resolvedAvatar = "/favicon.svg";
}
---

<div class="fuwari-card p-6 flex flex-col items-center text-center">
  <!-- 头像容器与光晕 -->
  <div class="relative group mb-4">
    <div
      class="absolute -inset-1 rounded-full bg-gradient-to-r from-accent to-emerald-400 opacity-60 blur group-hover:opacity-100 transition duration-500"
    >
    </div>
    <img
      src={resolvedAvatar}
      alt={authorName}
      class="relative w-24 h-24 rounded-full object-cover border-2 border-background shadow-md transform transition duration-500 group-hover:scale-105 bg-background"
      loading="lazy"
    />
  </div>

  <!-- 昵称与简介 -->
  <h3 class="text-xl font-bold tracking-tight text-foreground">
    {authorName}
  </h3>
  <p class="text-xs text-muted-foreground mt-1.5 line-clamp-2 px-2 leading-relaxed">
    {authorBio}
  </p>

  <!-- 站点数据统计小方块 -->
  <div class="grid grid-cols-3 gap-2 w-full mt-5 py-3 border-y border-border/50 text-center">
    <a href="/archives" class="group flex flex-col items-center hover:text-accent transition-colors">
      <span class="text-xs text-muted-foreground group-hover:text-accent">文章</span>
      <span class="text-base font-bold text-foreground group-hover:text-accent mt-0.5">{postsCount}</span>
    </a>
    <a href="/archives" class="group flex flex-col items-center hover:text-accent transition-colors">
      <span class="text-xs text-muted-foreground group-hover:text-accent">年份</span>
      <span class="text-base font-bold text-foreground group-hover:text-accent mt-0.5">{yearsCount}</span>
    </a>
    <a href="/tags" class="group flex flex-col items-center hover:text-accent transition-colors">
      <span class="text-xs text-muted-foreground group-hover:text-accent">标签</span>
      <span class="text-base font-bold text-foreground group-hover:text-accent mt-0.5">{tagsCount}</span>
    </a>
  </div>

  <!-- 社交与快捷通道 -->
  <div class="flex items-center justify-center gap-3 mt-5 w-full">
    {githubUrl && (
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="w-9 h-9 rounded-xl flex items-center justify-center bg-muted/60 hover:bg-accent hover:text-accent-foreground transition-all duration-300 transform hover:-translate-y-0.5"
        title="GitHub"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    )}
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
      target="_blank"
      aria-label="RSS Feed"
      class="w-9 h-9 rounded-xl flex items-center justify-center bg-muted/60 hover:bg-amber-500 hover:text-white transition-all duration-300 transform hover:-translate-y-0.5"
      title="RSS"
    >
      <IconRss class="w-4 h-4 stroke-current stroke-2" />
    </a>
    <a
      href="/"
      aria-label="回到主页"
      class="w-9 h-9 rounded-xl flex items-center justify-center bg-muted/60 hover:bg-accent hover:text-accent-foreground transition-all duration-300 transform hover:-translate-y-0.5"
      title="博客主页"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    </a>
  </div>
</div>
