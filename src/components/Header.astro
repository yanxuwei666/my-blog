---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import FuwariSearchModal from "./fuwari/FuwariSearchModal.astro";
import config from "@/config";

const { site } = config;
const locale = Astro.currentLocale ?? config.site.lang;

const stripTrailingSlash = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = stripTrailingSlash(Astro.url.pathname);

const navItems = site.nav.map(item => {
  // href 留空的标签只占位不跳转；指向站外的绝对地址也不参与「当前页」高亮
  if (!item.href || /^[a-z][a-z\d+\-.]*:\/\//i.test(item.href)) {
    return { title: item.title, href: item.href, active: false };
  }
  const href = getRelativeLocaleUrl(locale, item.href.replace(/^\/+/, ""));
  const path = stripTrailingSlash(href);
  return {
    title: item.title,
    href,
    active: currentPath === path || currentPath.startsWith(`${path}/`),
  };
});
---

<!-- 顶部常规导航栏 (自然随页面滚动，不吸顶) -->
<header class="relative z-40 w-full transition-all duration-300">
  <div class="page-shell pt-2 sm:pt-3">
    <div
      class="fuwari-card !rounded-2xl h-14 sm:h-16 px-3 sm:px-5 flex items-center justify-between shadow-sm bg-background/80 backdrop-blur-md border border-border/80"
    >
      <!-- 左侧站点 Logo / 标题，点击返回首页 -->
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="flex items-center gap-2 font-bold text-base sm:text-lg text-foreground hover:text-accent transition-colors shrink-0 group px-2 py-1.5 rounded-lg"
      >
        <div class="w-8 h-8 rounded-xl bg-accent/15 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-accent-foreground transition-all">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 3L2 12h3v8h6v-6h2v6h6v-8h3L12 3z"/>
          </svg>
        </div>
        <span class="tracking-tight">{site.title}</span>
      </a>

      <!-- 中间菜单导航项（大屏展示，圆角悬浮背景态） -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2">
        {navItems.map(item => (
          item.href ? (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all",
                item.active
                  ? "bg-accent text-accent-foreground shadow-sm"
                  : "text-foreground/75 hover:text-foreground hover:bg-muted/80"
              ]}
            >
              {item.title}
            </a>
          ) : (
            <span
              class="px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold text-foreground/40 cursor-default"
              title="内容还没有上线"
            >
              {item.title}
            </span>
          )
        ))}
      </nav>

      <!-- 右侧操作工具栏：搜索呼出、明暗主题切换、移动端汉堡菜单 -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- 搜索按钮（对标 Fuwari Search 触发器） -->
        <button
          type="button"
          data-open-search
          class="w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="搜索 (Ctrl+K)"
          aria-label="搜索全站文章"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- 暗黑模式切换按钮 -->
        <button
          id="theme-btn"
          type="button"
          class="w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="切换日夜模式"
          aria-label="切换明暗主题"
        >
          <IconSunHigh class="w-4 h-4 hidden dark:block" />
          <IconMoon class="w-4 h-4 block dark:hidden" />
        </button>

        <!-- 移动端展开抽屉按钮 -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden w-9 h-9 rounded-xl flex items-center justify-center text-foreground/75 hover:text-accent hover:bg-accent/10 transition-colors"
          title="展开导航菜单"
          aria-label="移动端菜单"
          aria-expanded="false"
          aria-controls="mobile-menu-panel"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 移动端展开悬浮面板 -->
    <div
      id="mobile-menu-panel"
      class="hidden md:hidden fuwari-card mt-2 p-3 bg-background/95 backdrop-blur-md border border-border shadow-lg transition-all"
    >
      <div class="flex flex-col gap-1 text-sm font-semibold">
        {navItems.map(item => (
          item.href ? (
            <a
              href={item.href}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "px-3 py-2 rounded-lg transition-all",
                item.active
                  ? "bg-accent text-accent-foreground font-semibold"
                  : "text-foreground/80 hover:text-foreground hover:bg-muted/80 font-medium"
              ]}
            >
              {item.title}
            </a>
          ) : (
            <span class="px-3 py-2 rounded-lg text-foreground/40 font-medium cursor-default">
              {item.title}
            </span>
          )
        ))}
      </div>
    </div>
  </div>
</header>

<!-- 全局搜索 Modal 浮层挂载 -->
<FuwariSearchModal />

<script>
  function setupHeader() {
    const menuBtn = document.getElementById("mobile-menu-toggle");
    const menuPanel = document.getElementById("mobile-menu-panel");
    if (!menuBtn || !menuPanel) return;

    // 使用 onclick 确保单次绑定，避免 addEventListener 重复注册导致 toggle 互相抵消
    menuBtn.onclick = (e) => {
      e.stopPropagation();
      const isHidden = menuPanel.classList.toggle("hidden");
      menuBtn.setAttribute("aria-expanded", String(!isHidden));
    };

    // 点击菜单项后自动收起菜单
    menuPanel.querySelectorAll("a").forEach((link) => {
      link.onclick = () => {
        menuPanel.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
      };
    });
  }

  // 点击页面外部区域自动收起移动端菜单
  document.addEventListener("click", (e) => {
    const menuBtn = document.getElementById("mobile-menu-toggle");
    const menuPanel = document.getElementById("mobile-menu-panel");
    if (menuPanel && !menuPanel.classList.contains("hidden")) {
      const target = e.target as Node;
      if (!menuBtn?.contains(target) && !menuPanel.contains(target)) {
        menuPanel.classList.add("hidden");
        menuBtn?.setAttribute("aria-expanded", "false");
      }
    }
  });

  document.addEventListener("astro:page-load", setupHeader);
</script>
