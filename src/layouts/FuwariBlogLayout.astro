---
import AstroPaperLayout from "@/layouts/AstroPaperLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FuwariProfile from "@/components/fuwari/FuwariProfile.astro";
import FuwariArchiveWidget from "@/components/fuwari/FuwariArchiveWidget.astro";
import FuwariTagsWidget from "@/components/fuwari/FuwariTagsWidget.astro";
import config from "@/config";

interface Props {
  title?: string;
  description?: string;
  postsCount?: number;
  years?: { year: string; count: number }[];
  tags?: { tag: string; count?: number }[];
}

const {
  title = `${config.site.title} - 博客`,
  description = config.site.description,
  postsCount = 0,
  years = [],
  tags = [],
} = Astro.props;
---

<AstroPaperLayout title={title} description={description}>
  <!-- 顶部全局导航栏 -->
  <Header />

  <!-- 主容器宽度由 site.pageWidth 控制；左侧固定 17.5rem -->
  <div class="page-shell pb-16 pt-4">
    <div class="grid grid-cols-1 lg:grid-cols-[17.5rem_1fr] gap-4 items-start">
      <!-- 左侧边栏 (Profile + 归档挂件 + 标签挂件) -->
      <aside class="space-y-4 lg:sticky lg:top-4 order-2 lg:order-1 w-full">
        <FuwariProfile
          postsCount={postsCount}
          categoriesCount={years.length}
          tagsCount={tags.length}
        />
        <FuwariArchiveWidget years={years} />
        <FuwariTagsWidget tags={tags} />
      </aside>

      <!-- 右侧主内容区 (文章 Bento 卡片流) -->
      <main class="order-1 lg:order-2 min-w-0">
        <slot />
      </main>
    </div>
  </div>

  <!-- 统一页脚 -->
  <Footer />
</AstroPaperLayout>
