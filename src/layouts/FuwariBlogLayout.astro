---
import AstroPaperLayout from "@/layouts/AstroPaperLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FuwariProfile from "@/components/fuwari/FuwariProfile.astro";
import FuwariArchiveWidget from "@/components/fuwari/FuwariArchiveWidget.astro";
import FuwariCategoryWidget from "@/components/fuwari/FuwariCategoryWidget.astro";
import FuwariTagsWidget from "@/components/fuwari/FuwariTagsWidget.astro";
import config from "@/config";

interface Props {
  home?: boolean;
  title?: string;
  description?: string;
  postsCount?: number;
  years?: { year: string; count: number }[];
  categories?: { category: string; count?: number }[];
  tags?: { tag: string; count?: number }[];
}

const {
  home = false,
  title = `${config.site.title} - 博客`,
  description = config.site.description,
  postsCount = 0,
  years = [],
  categories = [],
  tags = [],
} = Astro.props;
---

<AstroPaperLayout title={title} description={description}>
  <!-- 顶部全局导航栏 -->
  <Header />

  <div class:list={["page-shell pb-16 pt-4", { "blog-home": home }]}>
    <div class:list={home ? "home-columns" : "grid grid-cols-1 items-start gap-4 lg:grid-cols-[17.5rem_1fr]"}>
      <aside
        class:list={home ? "home-sidebar space-y-4" : "order-2 w-full space-y-4 lg:sticky lg:top-5 lg:order-1"}
        aria-label="博主介绍、文章分类与归档"
      >
        <FuwariProfile postsCount={postsCount} categoriesCount={categories.length} tagsCount={tags.length} />
        <FuwariArchiveWidget years={years} />
        <FuwariCategoryWidget categories={categories} limit={home ? 12 : 8} />
        <FuwariTagsWidget tags={tags} />
      </aside>
      <main class:list={home ? "home-main min-w-0" : "order-1 lg:order-2 min-w-0"}><slot /></main>
    </div>
  </div>

  <!-- 统一页脚 -->
  <Footer />
</AstroPaperLayout>
